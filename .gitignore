# --- secrets / env ---
.env
*.env
!.env.example

# --- models / results (never in git) ---
*.gguf
*.safetensors
models/
# tasks_probe/ is generated by scripts/build_probe_dir.py (the probe subset of the
# changed tasks); regenerating it from tasks/ is always cheaper than reviewing a diff.
tasks_probe/
results/*
# Hard exclusion, stated separately from the blanket rule above because it encodes a
# privacy decision rather than housekeeping: these are raw sweep console logs whose
# first line reproduces the whole command, including the lane endpoint and local
# paths. They are NEVER publishable and must never be force-added the way the epoch
# run logs are. `tests/test_repo_privacy.py` fails if any file under this directory
# ever becomes tracked.
results/_sweep_logs/
# EXCEPTION, deliberate: the run log of every ranked configuration in the current epoch is
# tracked, because the published leaderboard has to be reproducible from a clone (63 files,
# epoch 0.6.0, endpoint address scrubbed). They are force-added — `git add` obeys the rule
# above, so publishing a log must be `git add -f results/<model>_<ts>.json`, on purpose.
# Everything else under results/ (repeat runs, perf artifacts, ad-hoc probes) stays out.
!results/.gitkeep
!results/_published
!results/_published/**
!results/cards
# The lane-gate proofs are RECEIPTS, not run output: a refusal is only trustworthy if the exit
# code it quoted is in the repo, so these are tracked on purpose.
!results/_preflight
!results/_preflight/**

# --- python ---
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
build/
dist/

# --- editor/OS ---
.DS_Store
.idea/
.vscode/

# Internal reassessment inventory — never published
REASSESSMENT-P0-INVENTORY.md
