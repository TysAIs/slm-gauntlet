# --- secrets / env ---
.env
*.env
!.env.example

# --- models / results (never in git) ---
*.gguf
*.safetensors
models/
# tasks_probe/ is generated by scripts/build_probe_dir.py (the probe subset of the
# changed tasks); regenerating it from tasks/ is always cheaper than reviewing a diff.
tasks_probe/
results/*
!results/.gitkeep
!results/_published
!results/_published/**
!results/cards
# The lane-gate proofs are RECEIPTS, not run output: a refusal is only trustworthy if the exit
# code it quoted is in the repo, so these are tracked on purpose.
!results/_preflight
!results/_preflight/**

# --- python ---
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
build/
dist/

# --- editor/OS ---
.DS_Store
.idea/
.vscode/
